From: HONOR ZQC-P Linux fixes <noreply@example.invalid>
Date: Sat, 30 May 2026 02:00:00 +0300
Subject: [PATCH] platform/x86: huawei-wmi: Storm-detection for KEY_MICMUTE
 (WMI 0x287)

On some HONOR MagicBook and Huawei MateBook EC firmware revisions, the
embedded controller autonomously fires the mic-privacy WMI event 0x287
in burst patterns of 2-4+ events separated by 0.7-1.5 seconds ("privacy
storm"), without any user keypress. Confirmed reproduction on HONOR
MagicBook Pro 14 AI (ZQC-P / M1010, Intel Core Ultra X9 388H, Panther
Lake) running linux-cachyos 7.0.10. The EC also writes the legacy PS/2
scancode 0xf8 to i8042 in parallel, which surfaces in dmesg as
  atkbd serio0: Unknown key pressed (translated set 2, code 0xf8
  on isa0060/serio0).

Each burst's KEY_MICMUTE events toggle the default source mute, which
in theory should self-cancel for even-count bursts; but in practice
userspace dispatch races (Wayland compositor + gsd-media-keys grab +
audio backend) lose some of the toggles, leaving the mic stuck muted
with the platform::micmute LED on. The user-visible symptom is "mic
mutes itself spontaneously and the Fn+F7 hardware shortcut no longer
restores it."

The root cause is in the EC firmware and the trigger is not exposed
via any documented ACPI/WMI dispatch method (the full WMAA dispatcher
in SSDT21 was audited -- only the OS->EC setter SMLS touches the mic
state, and no "disable privacy timer" setter exists). HONOR's own
Windows PCManager binaries do not call any such setter either --
Windows is simply fast enough that the 2-event self-cancel returns
mute to the original state without a visible LED flicker.

Detect the storm with a "permissive-by-default, guarded-after-burst"
hybrid algorithm at the driver level:

  Mode PERMISSIVE (default after boot):
    - Every 0x287 event is emitted immediately on arrival
      -- legitimate Fn+F7 presses have zero added latency, exactly
      matching the upstream behaviour the user expects.
    - A watch timer arms (or re-arms via mod_delayed_work) to fire
      micmute_storm_window_ms after the most recent event.
    - When the timer expires:
        count == 1 -> single press, nothing to do.
        count >= 2 -> burst observed. The events were already
                      emitted naturally, so:
                        even count: 0 net mute change (good).
                        odd count : emit one more KEY_MICMUTE for
                                    parity, also yielding 0 net.
                      In either case, switch to GUARDED mode and
                      stamp last_burst_jiffies.

  Mode GUARDED (active for micmute_storm_cooldown_ms after the most
                recent burst, default 5 minutes):
    - First 0x287 of a fresh window is emitted immediately
      (single presses still feel instant inside guard period).
    - Subsequent 0x287 events within the window are NOT emitted;
      they only increment the counter and re-arm the timer.
    - When the timer expires:
        count == 1 -> single press, nothing to do.
        count >= 2 -> burst; emit one compensating KEY_MICMUTE so
                      the net mute change for the burst is zero.
                      Refresh last_burst_jiffies to extend the
                      guard period.

After micmute_storm_cooldown_ms with no further bursts, the driver
reverts to PERMISSIVE -- normal single-press use is fully unaffected
once the EC has been quiet for a while.

The two parameters can be tuned at runtime via /sys/module:
  micmute_storm_window_ms     (default 2000)
      Burst-detection window. Lower = snappier compensation but at
      risk of missing slow storm patterns. 0 disables the feature
      entirely (pure upstream behaviour).
  micmute_storm_cooldown_ms   (default 300000 = 5 minutes)
      How long the GUARDED mode stays active after a burst is
      observed. 0 keeps the driver in PERMISSIVE forever (parity
      correction still happens for any single burst, but rapid
      user testing right after a storm will not be absorbed).

For burst patterns where individual events are spread >= window_ms
apart (an outlier observed on this unit at ~3-6 s intervals), each
event is treated as a separate single press; the kernel cannot
distinguish such a slow burst from human presses without misclassifying
legitimate use, so that case is left to userspace dispatch reliability.

All other WMI events (volume, brightness, wlan, ...) keep upstream
immediate-emit behaviour.

Tested-on: HONOR MagicBook Pro 14 AI ZQC-P / M1010 (1ee7:209d)
Signed-off-by: HONOR ZQC-P Linux fixes <noreply@example.invalid>
---
 drivers/platform/x86/huawei-wmi.c | 121 ++++++++++++++++++++++++++++++
 1 file changed, 96 insertions(+)

diff --git a/drivers/platform/x86/huawei-wmi.c b/drivers/platform/x86/huawei-wmi.c
--- a/drivers/platform/x86/huawei-wmi.c
+++ b/drivers/platform/x86/huawei-wmi.c
@@ -17,6 +17,7 @@
 #include <linux/platform_device.h>
 #include <linux/power_supply.h>
 #include <linux/sysfs.h>
+#include <linux/workqueue.h>
 #include <linux/wmi.h>
 #include <acpi/battery.h>
 
@@ -104,6 +105,97 @@
 MODULE_PARM_DESC(report_brightness,
 		"Report brightness keys.");
 
+/*
+ * KEY_MICMUTE storm detection -- see commit message for full background.
+ *
+ * Mode PERMISSIVE (default after boot): every 0x287 emits immediately.
+ * A watch timer covers micmute_storm_window_ms; if 2+ events fall in
+ * the same window, the algorithm emits one extra KEY_MICMUTE only if
+ * the burst count is odd (parity correction yields 0 net mute change
+ * for both even and odd bursts in PERMISSIVE), then switches to
+ * GUARDED mode.
+ *
+ * Mode GUARDED (active for micmute_storm_cooldown_ms after the last
+ * burst): first event of the window emits immediately, subsequent
+ * events are dropped; at window expiry one compensating KEY_MICMUTE
+ * is emitted iff the burst count was >= 2. Single presses inside the
+ * guard period still feel instant; rapid bursts (storm or user
+ * testing) self-cancel.
+ *
+ * Set micmute_storm_window_ms to 0 to disable both modes entirely.
+ * Set micmute_storm_cooldown_ms to 0 to stay PERMISSIVE forever.
+ */
+static int micmute_storm_window_ms = 2000;
+module_param(micmute_storm_window_ms, int, 0644);
+MODULE_PARM_DESC(micmute_storm_window_ms,
+		"EC privacy-storm window (ms) for KEY_MICMUTE (0x287); 0 disables.");
+
+static int micmute_storm_cooldown_ms = 300000;
+module_param(micmute_storm_cooldown_ms, int, 0644);
+MODULE_PARM_DESC(micmute_storm_cooldown_ms,
+		"How long after a burst the driver stays in GUARDED mode (ms); 0 = never.");
+
+static atomic_t huawei_wmi_micmute_count = ATOMIC_INIT(0);
+static unsigned long huawei_wmi_micmute_last_burst;
+static bool huawei_wmi_micmute_burst_guarded;
+static struct input_dev *huawei_wmi_micmute_idev;
+static const struct key_entry *huawei_wmi_micmute_key;
+
+static void huawei_wmi_micmute_compensate(struct work_struct *work);
+static DECLARE_DELAYED_WORK(huawei_wmi_micmute_work,
+			    huawei_wmi_micmute_compensate);
+
+static bool huawei_wmi_micmute_in_cooldown(void)
+{
+	int cooldown_ms = READ_ONCE(micmute_storm_cooldown_ms);
+
+	if (cooldown_ms <= 0 || huawei_wmi_micmute_last_burst == 0)
+		return false;
+	return time_before(jiffies,
+			   huawei_wmi_micmute_last_burst +
+			   msecs_to_jiffies(cooldown_ms));
+}
+
+static void huawei_wmi_micmute_compensate(struct work_struct *work)
+{
+	int count = atomic_xchg(&huawei_wmi_micmute_count, 0);
+	int emits;
+
+	if (count < 2)
+		return;
+
+	emits = huawei_wmi_micmute_burst_guarded ? 1 : count;
+	huawei_wmi_micmute_last_burst = jiffies;
+
+	if ((emits & 1) && huawei_wmi_micmute_idev && huawei_wmi_micmute_key)
+		sparse_keymap_report_entry(huawei_wmi_micmute_idev,
+					   huawei_wmi_micmute_key, 1, true);
+}
+
+static bool huawei_wmi_micmute_filter(struct input_dev *idev,
+				      const struct key_entry *key)
+{
+	int window_ms = READ_ONCE(micmute_storm_window_ms);
+	int count;
+
+	if (window_ms <= 0)
+		return false;
+
+	huawei_wmi_micmute_idev = idev;
+	huawei_wmi_micmute_key = key;
+
+	count = atomic_inc_return(&huawei_wmi_micmute_count);
+	if (count == 1)
+		huawei_wmi_micmute_burst_guarded =
+			huawei_wmi_micmute_in_cooldown();
+
+	mod_delayed_work(system_wq, &huawei_wmi_micmute_work,
+			 msecs_to_jiffies(window_ms));
+
+	return huawei_wmi_micmute_burst_guarded && (count > 1);
+}
+
+
 /* Quirks */
 
 static int __init dmi_matched(const struct dmi_system_id *dmi)
@@ -735,6 +827,9 @@
 			key->sw.code == KEY_BRIGHTNESSUP))
 		return;
 
+	if (code == 0x287 && huawei_wmi_micmute_filter(idev, key))
+		return;
+
 	sparse_keymap_report_entry(idev, key, 1, true);
 }
 
@@ -780,6 +875,7 @@
 
 static void huawei_wmi_input_exit(struct device *dev, const char *guid)
 {
+	cancel_delayed_work_sync(&huawei_wmi_micmute_work);
 	wmi_remove_notify_handler(guid);
 }
 
