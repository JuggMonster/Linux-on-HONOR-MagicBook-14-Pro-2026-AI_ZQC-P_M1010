[Unit]
# HONOR MagicBook Pro 14 AI (ZQC-P / M1010) — Fn+F7 mic-mute keymap.
#
# Root cause: systemd-udev builtin "keyboard" calls EVIOCSKEYCODE_V2 on the
# evdev device, which the atkbd driver rejects with -EINVAL for extended
# scancodes (0xE0xx). The legacy kbd ioctls used by /usr/bin/setkeycodes
# do work for the same scancode on the same driver, so we apply the map
# that way on boot.
#
# When systemd/atkbd start agreeing on the V2 API the hwdb file
# (/etc/udev/hwdb.d/61-keyboard-honor-zqc-p.hwdb) will start working on
# its own and this unit can be disabled.
Description=HONOR ZQC-P Fn+F7 mic-mute scancode mapping
Documentation=https://github.com/rs0x29a/Linux-on-HONOR-MagicBook-14-Pro-2026-AI_ZQC-P_M1010
After=systemd-modules-load.service systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/bin/setkeycodes e078 248
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
